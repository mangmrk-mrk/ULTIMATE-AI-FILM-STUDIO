# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
HOST=127.0.0.1
# หลาย origin คั่นด้วย comma เช่น https://yourname.github.io,http://localhost:5500  (ค่าเริ่มต้น * = อนุญาตทุก origin)
ALLOWED_ORIGIN=*
RATE_LIMIT_PER_MIN=20
# ตั้ง MOCK=1 เพื่อทดสอบโดยไม่ต้องมี API key
MOCK=0
